;Comix Zone: SR's llasm_pushx.llinc with the stack accesses marked unaligned.
;The game's tasks have their own stacks inside its heap (blocks of 2-byte
;alignment), so esp is not a multiple of 4 and "align 4" on a push or a pop
;is undefined behaviour for LLVM: it dropped code after such accesses.
;The C half (x86_pushad...) is SR's llasm_pushx.c.

funcv x86_pushad $
funcv x86_pushaw $
funcv x86_popad $
funcv x86_popaw $
funcv x86_popfd $
funcv x86_popfw $

macro PUSH val
    sub esp, esp, 4
    store \val, esp, 1
endm

macro PUSHAD
    call x86_pushad $
endm

macro PUSHAW
    call x86_pushaw $
endm

macro PUSHFD
    sub esp, esp, 4
    store eflags, esp, 1
endm

macro PUSHFW
    sub esp, esp, 2
    store16 eflags, esp, 1
endm


macro POP reg
    load \reg, esp, 1
    add esp, esp, 4
endm

macro POPAD
    call x86_popad $
endm

macro POPAW
    call x86_popaw $
endm

macro POPFD
    call x86_popfd $
endm

macro POPFW
    call x86_popfw $
endm

